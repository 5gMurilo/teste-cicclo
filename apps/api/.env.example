# Local development only. Copy to .env and replace the example password.
# Use single quotes when the password has $, quotes or other special characters: Compose reads them literally.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Host port of the API started by scripts/start-demo.sh (bound to 127.0.0.1).
API_PORT=5001
# Optional OTLP/HTTP collector base URL reachable from the API container, e.g. http://host.docker.internal:4318/
# CICCLO_OTLP_ENDPOINT=
# Optional Redis cache (Compose profile "cache"), off by default and never needed by the base demo.
# Enable it per run with: CICCLO_CACHE_ENABLED=true apps/api/scripts/start-demo.sh (start-demo.sh ignores that flag in this file).
# The password is required only for that profile; use letters and digits only, e.g. the output of: openssl rand -hex 24
# REDIS_PASSWORD=
# Host port of the optional Redis (bound to 127.0.0.1).
# REDIS_PORT=6379
# Cache TTL in seconds, counted from each cache write (1 to 3600).
# CICCLO_CACHE_TTL_SECONDS=30
