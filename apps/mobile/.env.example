# Origem da API, sem caminho, query ou credenciais (o prefixo /api/v1 e acrescentado pelo app).
# Emulador Android: http://10.0.2.2:5001 | Simulador iOS: http://localhost:5001
# Aparelho fisico: http://<IP-da-maquina-na-rede-local>:5001
EXPO_PUBLIC_API_URL=http://localhost:5001

# Nome exibido na saudacao do header. Vazio ou ausente exibe "Visitante".
EXPO_PUBLIC_DEMO_DISPLAY_NAME=

# Demo: mostra o botao "Concluir (simulacao)" no detalhe de uma execucao em andamento.
# So funciona com a API em Development e Laundry__DemoMode=true. Deixe vazio fora da demo.
EXPO_PUBLIC_DEMO_SIMULATION=
