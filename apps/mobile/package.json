    "typecheck": "tsc --noEmit",
    "test": "jest --ci --runInBand --verbose"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-network": "58.0.4",
    "expo-router": "58.0.24",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
